# URL del proyecto y clave publicable (o anon heredada), nunca service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Activar solo después de desplegar y probar la nueva RPC de lectura.
VITE_RESERVAS_LECTURA=false

# Habilitar solo después de desplegar y verificar la migración de lectura.
VITE_OPERACIONES_LECTURA=false

# Solo tras desplegar y probar las RPC de pagos.
VITE_PAGOS_ESCRITURA=false

# Solo tras desplegar y probar las RPC correspondientes.
VITE_ESTADIAS_ESCRITURA=false
VITE_PRECIOS_ESCRITURA=false

# Solo después de desplegar y verificar la migración de consumos y mantenimiento.
VITE_OPERACIONES_ESCRITURA=false

# Solo tras desplegar y verificar altas administrativas en el proyecto elegido.
VITE_ALTAS_CATALOGO=false
